-- auto walk to spawn door (DO NOT TOUCH THIS SHIT NO MATTER WHAT)
local walking=false
local targetPos=Vector3.new(34.1444511, 4.5400238, -360.722107)

MiscTab:CreateToggle({
   Name="Auto Walk To Door",
   Callback=function(v)
      walking=v

      if v then
         task.spawn(function()
            while walking do
               local char=getChar()
               local hum=char:FindFirstChildOfClass("Humanoid")

               if hum then
                  for i=1,10 do
                     if not walking then break end
                     hum:MoveTo(targetPos)
                     task.wait(0.1)
                  end
               end

               task.wait(0.1)
            end
         end)
      end
   end
})

-- Auto press F (for door) Only change keybind if needed
local pressingF = false

MiscTab:CreateToggle({
    Name = "Auto Interact (F)",
    CurrentValue = false,
    Callback = function(v)
        pressingF = v
        if pressingF then
            task.spawn(function()
                while pressingF do
                    game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.F, false, game)
                    task.wait(0.1) -- << dont touch this
                    game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.F, false, game)
                    task.wait(1) -- delay (default 1 sec)
                end
            end)
        end
    end
})

