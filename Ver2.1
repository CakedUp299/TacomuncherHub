-- Aimbot (don't touch)
local circle=Drawing.new("Circle")
circle.Thickness=2
circle.NumSides=100
circle.Filled=false

AimTab:CreateToggle({Name="Enable Aimbot",Callback=function(v)a=v end})
AimTab:CreateToggle({Name="Use FOV",Callback=function(v)f=v end})
AimTab:CreateToggle({Name="Show FOV",Callback=function(v)fv=v end})
AimTab:CreateSlider({Name="FOV Size",Range={20,300},Increment=5,CurrentValue=70,Callback=function(v)fr=v end})

r.RenderStepped:Connect(function()
   circle.Position=Vector2.new(c.ViewportSize.X/2,c.ViewportSize.Y/2)
   circle.Radius=fr
   circle.Visible=fv

   if not a or not t then return end

   local cl,dist=nil,(f and fr or math.huge)

   for _,v in ipairs(t:GetChildren()) do
      local h=v:FindFirstChild("Head")
      if h then
         local s,on=c:WorldToViewportPoint(h.Position)
         local m=(f and on)
            and (Vector2.new(s.X,s.Y)-circle.Position).Magnitude
            or (h.Position-c.CFrame.Position).Magnitude

         if m<dist then
            dist=m
            cl=h
         end
      end
   end

   if cl then
      c.CFrame=CFrame.new(c.CFrame.Position,cl.Position)
   end
end)

u.InputBegan:Connect(function(i,g)
   if not g and i.KeyCode==Enum.KeyCode.L then
      a=not a
   end
end)

